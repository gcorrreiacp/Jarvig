# Settings for emp_alerts.py (mock EMP alert emails sent through Brevo).
# Copy to scripts/.env and fill in. Real environment variables take precedence over this file.

# Sender address, verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
DOJO_SENDER=

# Brevo SMTP login and key (SMTP & API -> SMTP tab)
DOJO_SMTP_USER=
DOJO_SMTP_KEY=

# Optional: where the alerts go (default jarvig120@gmail.com; --to overrides it)
# DOJO_ALERTS=someone@example.com
