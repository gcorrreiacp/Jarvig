# ---- Assistant ----
ASSISTANT_NAME=AURA
SYSTEM_PROMPT=You are AURA, a calm, precise, slightly witty personal assistant. Keep spoken answers short unless asked for detail.

# ---- Which agent the bridge talks to ----
# echo | openai | anthropic | claude_code | webhook | custom
AGENT_PROVIDER=echo

# openai: any OpenAI-compatible server (OpenAI, Ollama, LM Studio, vLLM, Groq, OpenRouter...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama example:  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# claude_code: Claude via the Claude Code CLI and your Claude account login (no API key).
# Install: curl -fsSL https://claude.ai/install.sh | bash   then: claude auth login
# CLAUDE_CODE_MODEL is optional (e.g. sonnet, opus); empty uses your account's default.
CLAUDE_CODE_CLI=claude
CLAUDE_CODE_MODEL=

# webhook: your own agent service (n8n, LangGraph server, CrewAI API, etc.)
WEBHOOK_URL=
WEBHOOK_TOKEN=

# custom: a Python class implementing agent.base.Agent, as "module.path:ClassName"
CUSTOM_AGENT=agent.examples.my_agent:MyAgent

# ---- Bridge ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
HISTORY_LIMIT=20

# ---- Gmail connector (read-only) ----
# OAuth desktop client from Google Cloud Console, and where the user token is stored
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
