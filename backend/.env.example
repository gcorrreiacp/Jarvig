# ---- Assistant ----
ASSISTANT_NAME=J.A.R.V.I.G.
SYSTEM_PROMPT=You are J.A.R.V.I.G., a calm, precise, slightly witty personal assistant. Keep spoken answers short unless asked for detail.

# ---- Which agent the bridge talks to ----
# echo | openai | anthropic | claude_code | webhook | custom
AGENT_PROVIDER=echo

# openai: any OpenAI-compatible server (OpenAI, Ollama, LM Studio, vLLM, Groq, OpenRouter...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama example:  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# claude_code: Claude via the Claude Code CLI and your Claude account login (no API key).
# Install: curl -fsSL https://claude.ai/install.sh | bash   then: claude auth login
# CLAUDE_CODE_MODEL is optional (e.g. sonnet, opus); empty uses your account's default.
CLAUDE_CODE_CLI=claude
CLAUDE_CODE_MODEL=

# webhook: your own agent service (n8n, LangGraph server, CrewAI API, etc.)
WEBHOOK_URL=
WEBHOOK_TOKEN=

# custom: a Python class implementing agent.base.Agent, as "module.path:ClassName"
CUSTOM_AGENT=agent.examples.my_agent:MyAgent

# ---- Voice ----
# With a key, replies are spoken by ElevenLabs through /api/tts and the orb reacts to the real audio.
# Empty uses the browser's built-in male voice. The key stays on the server.
# ELEVENLABS_VOICE_ID is a male British voice ("George"); pick another in the ElevenLabs voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Bridge ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
HISTORY_LIMIT=20

# ---- Gmail files ----
# NOT read from this file. Gmail always uses these files in backend/, whichever folder you start from:
#   credentials.json      OAuth client downloaded from Google Cloud Console
#   token.json            your Gmail sign-in, written by: python -m connectors.gmail auth --modify
#   alert_filters.json    incident analysis rules (copy alert_filters.example.json)
#   data/candidates.jsonl queue of candidate emails, written by incident analysis
# To use other locations, export an environment variable in the terminal BEFORE starting, e.g.
#   export GMAIL_TOKEN_FILE=/path/to/token.json
# (also GMAIL_CREDENTIALS_FILE, GMAIL_FILTERS_FILE, GMAIL_CANDIDATES_FILE). Relative paths are from backend/.

# ---- Incident dispatcher: uploads candidate alert emails to FTP as text files ----
# FTP_TLS=true uses FTPS (encrypted); set false only for a server without TLS.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_DIR=/incidents
FTP_TLS=true
DISPATCH_POLL_SECONDS=60
